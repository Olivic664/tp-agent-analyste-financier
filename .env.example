# =============================================================================
# TP Agent Analyste — Configuration de la clé d'API
# =============================================================================
# 1. Copie ce fichier sous le nom ".env" (attention : il commence par un point)
#      cp .env.example .env
# 2. Renseigne ta clé OpenAI ci-dessous (https://platform.openai.com/api-keys)
# 3. Le fichier .env ne doit JAMAIS être versionné (git) : c'est un secret.
# =============================================================================

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Optionnel) Pointage vers un endpoint compatible OpenAI :
# - GLM (Zhipu)     : https://open.bigmodel.cn/api/paas/v4/
# - Ollama (local)  : http://localhost:11434/v1/   (model="llama3.1")
# Si tu changes de fournisseur, adapte aussi --model dans run.py.
# OPENAI_BASE_URL=
